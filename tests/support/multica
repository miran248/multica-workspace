#!/usr/bin/env node
import { readFileSync, writeFileSync } from 'node:fs';
import { command } from './platform.js';
const args = process.argv.slice(2);
if (process.env.FAKE_ERROR) { console.error('fake diagnostic'); process.exit(7); }
if (process.env.FAKE_INVALID_JSON) { console.log('{broken'); process.exit(0); }
const state = JSON.parse(readFileSync(process.env.FAKE_STATE, 'utf8'));
try {
  const scoped = args[0] === '--workspace-id';
  const call = args.slice(scoped ? 2 : 0);
  const [entity, action, third] = call;
  // Mirror the CLI surface: these commands reject --output; skill delete confirms with --yes.
  const silent = (entity === 'skill' && (action === 'delete' || (action === 'files' && third === 'delete')))
    || (entity === 'autopilot' && action === 'delete');
  if (silent && call.includes('--output')) throw new Error('unknown flag: --output');
  if (entity === 'skill' && action === 'delete' && !call.includes('--yes')) throw new Error('skill delete needs --yes');
  const json = args.at(-2) === '--output' && args.at(-1) === 'json';
  if (!silent && !json) throw new Error('Missing scope or JSON flags');
  if (!scoped && (silent ? call.join(' ') !== 'workspace get' : call.slice(0, -2).join(' ') !== 'workspace get'))
    throw new Error('Only workspace identity lookup may omit scope');
  const rest = (silent ? call : call.slice(0, -2)).filter(argument => argument !== '--yes');
  const result = command(state, scoped ? args[1] : '', ...rest);
  writeFileSync(process.env.FAKE_STATE, JSON.stringify(state));
  if (process.env.FAKE_STDERR) console.error('fake warning');
  if (!silent) console.log(JSON.stringify(result));
} catch (error) { console.error(error.message); process.exit(1); }
