{
  "type": "object",
  "properties": {
    "kind": {
      "enum": ["rename", "retire"]
    },
    "entity": {
      "enum": ["agent", "autopilot", "label", "skill", "squad", "workflow"]
    },
    "from": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "required": ["kind", "entity"],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
